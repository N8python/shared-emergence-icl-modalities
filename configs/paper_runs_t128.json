        "--backend",
        "mlx",
        "--trials-per-program",
        "128",
        "--bit-length",
        "8",
        "--max-new-tokens",
        "8",
        "--lmshuffle",
        "--per-trial-random"
      ],
      "conditions": {
        "clean": {
          "shots": [
            1,
            2,
            4,
            8,
            16,
            32,
            64
          ],
          "seeds": {
            "1": 1327989894,
            "2": 1604568574,
            "4": 1891216790,
            "8": 1909800047,
            "16": 1813863336,
            "32": 870204797,
            "64": 1958817553
          },
          "output_template": "qwen3/clean/Qwen3-14B-Base_ic{shot}.json"
        },
        "deranged": {
          "shots": [
            1,
            2,
            4,
            8,
            16,
            32,
            64
          ],
          "seeds": {
            "1": 1327989894,
